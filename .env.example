# Copy this file to ".env" (which is gitignored) and fill in real values
# before running `docker compose up`. Never commit the real .env file.

# SQL Server "sa" password used by the sqlserver container. Must satisfy
# SQL Server's complexity policy (8+ chars, 3 of: upper, lower, digit, symbol).
SA_PASSWORD=Change_This_Password123!

# Symmetric signing key for JWTs, base64-encoded, 256+ bits recommended.
# Generate one with: openssl rand -base64 64
JWT_KEY=Change_This_To_A_Long_Random_Base64_String
